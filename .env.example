# Neon Database Connection String
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Neon Auth Configurations (Managed Better Auth)
# Find these in your Neon Console project under the "Auth" tab
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/dbname/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/dbname/auth"

# Generate a secure 32-character base64 secret for cookies using:
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# AI Provider Keys
GROQ_API_KEY="your-groq-cloud-api-key"
MEM0_API_KEY="your-mem0-platform-api-key"
TAVILY_API_KEY="your-tavily-search-api-key"


